{
  "app": "LocalCloud",
  "version": "1.0.0",
  "settings": {
    "debug": false,
    "max_upload_size_mb": 512,
    "allowed_origins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "storage": {
    "backend": "minio",
    "endpoint": "localhost:9000",
    "bucket": "localcloud-files",
    "region": "us-east-1"
  },
  "users": [
    { "id": 1, "name": "Alice", "role": "admin", "quota_gb": 100 },
    { "id": 2, "name": "Bob",   "role": "user",  "quota_gb": 20  },
    { "id": 3, "name": "Carol", "role": "user",  "quota_gb": 20  }
  ]
}
