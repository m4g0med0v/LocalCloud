# Application
APP_NAME=LocalCloud
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=super-secret-key-change-in-production

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/localcloud
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Storage (MinIO / S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_FILES=localcloud-files
MINIO_BUCKET_TEMP=localcloud-temp
MINIO_BUCKET_ARCHIVES=localcloud-archives

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Quota
DEFAULT_STORAGE_GB=20
MAX_FILE_SIZE_MB=512
