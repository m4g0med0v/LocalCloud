<?xml version="1.0" encoding="UTF-8"?>
<localcloud version="1.0.0">

  <settings>
    <debug>false</debug>
    <max_upload_size_mb>512</max_upload_size_mb>
  </settings>

  <storage>
    <backend>minio</backend>
    <endpoint>localhost:9000</endpoint>
    <buckets>
      <bucket name="files">localcloud-files</bucket>
      <bucket name="temp">localcloud-temp</bucket>
      <bucket name="archives">localcloud-archives</bucket>
    </buckets>
  </storage>

  <users>
    <user id="1">
      <name>Alice</name>
      <role>admin</role>
      <quota_gb>100</quota_gb>
    </user>
    <user id="2">
      <name>Bob</name>
      <role>user</role>
      <quota_gb>20</quota_gb>
    </user>
  </users>

</localcloud>
